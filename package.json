    "deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "ical.js": "^2.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "wrangler": "^4.132.0"
  }
}
